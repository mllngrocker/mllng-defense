[node name="NpcVillagers_v 17 Root" type="StaticBody2D" parent="Entities" unique_id=1347037921]
position = Vector2(264, 190)
script = ExtResource("13_ksmrv")
display_name = "새싹 장로"
sheet = ExtResource("14_u7q0n")
lines = PackedStringArray("큰 나무의 뿌리 속에도 사람이 산다네. 우린 뿌리를 돌보는 새싹 일족이지.", "십 년 전, 검은 옷을 입은 사내가 뿌리 심장으로 내려갔어.", "그 뒤를 쫓아 사냥꾼 부부가 내려갔지… 돌아온 건 사내뿐이었다네.")

[node name="NpcVillagers_v 15 Root" type="StaticBody2D" parent="Entities" unique_id=845287384]
position = Vector2(472, 302)
script = ExtResource("13_ksmrv")
display_name = "약초꾼"
sheet = ExtResource("15_xg7a8")
lines = PackedStringArray("뿌리 물이 썩어서 약초가 다 시들었어요.", "벌레들이 뿌리를 갉아 먹고 점점 커지고 있어요.")

[node name="NpcVillagers_v 28 Root" type="StaticBody2D" parent="Entities" unique_id=477358256]
position = Vector2(408, 174)
script = ExtResource("13_ksmrv")
display_name = "로웰"
sheet = ExtResource("16_7yrms")
lines = PackedStringArray("…뿌리에 물을 주고 있다. 내가 망친 것을 내 손으로 되돌려야지.", "네 부모에게 못다 한 사과를, 나무에게라도 하고 있는 셈이다.")

[node name="NpcVillagers_v 06 Root" type="StaticBody2D" parent="Entities" unique_id=114343760]
position = Vector2(136, 318)
script = ExtResource("13_ksmrv")
display_name = "새싹 아이"
sheet = ExtResource("17_00tiy")
lines = PackedStringArray("형아도 사냥꾼이야? 할아버지가 그러는데, 옛날에도 멋진 사냥꾼이 왔었대!")

