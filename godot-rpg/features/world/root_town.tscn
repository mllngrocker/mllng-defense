[node name="NpcMonk" type="StaticBody2D" parent="Entities" unique_id=1045418267]
position = Vector2(264, 190)
script = ExtResource("13_nblso")
display_name = "새싹 장로"
sheet = ExtResource("14_ksmrv")
lines = PackedStringArray("큰 나무의 뿌리 속에도 사람이 산다네. 우린 뿌리를 돌보는 새싹 일족이지.", "십 년 전, 검은 옷을 입은 사내가 뿌리 심장으로 내려갔어.", "그 뒤를 쫓아 사냥꾼 부부가 내려갔지… 돌아온 건 사내뿐이었다네.")

[node name="NpcWoman" type="StaticBody2D" parent="Entities" unique_id=592639789]
position = Vector2(472, 302)
script = ExtResource("13_nblso")
display_name = "약초꾼"
sheet = ExtResource("15_u7q0n")
lines = PackedStringArray("뿌리 물이 썩어서 약초가 다 시들었어요.", "벌레들이 뿌리를 갉아 먹고 점점 커지고 있어요.")

[node name="NpcChild" type="StaticBody2D" parent="Entities" unique_id=41952759]
position = Vector2(136, 318)
script = ExtResource("13_nblso")
display_name = "새싹 아이"
sheet = ExtResource("16_xg7a8")
lines = PackedStringArray("형아도 사냥꾼이야? 할아버지가 그러는데, 옛날에도 멋진 사냥꾼이 왔었대!")

