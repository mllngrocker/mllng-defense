display_name = "새싹 장로"
sheet = ExtResource("15_7yrms")
lines = PackedStringArray("큰 나무의 뿌리 속에도 사람이 산다네. 우린 뿌리를 돌보는 새싹 일족이지.", "십 년 전, 검은 옷을 입은 사내가 뿌리 심장으로 내려갔어.", "그 뒤를 쫓아 사냥꾼 부부가 내려갔지… 돌아온 건 사내뿐이었다네.")

[node name="NpcVillagers_v 15 Root" type="StaticBody2D" parent="Entities" unique_id=520508962]
