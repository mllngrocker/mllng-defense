[node name="NpcOldman 2" type="StaticBody2D" parent="Entities" unique_id=269066853]
position = Vector2(264, 190)
script = ExtResource("13_woc8j")
display_name = "항구 촌장"
sheet = ExtResource("14_kvvaw")
lines = PackedStringArray("이 안개는 십 년 전, 탑이 별을 삼킨 날부터 걷히지 않는다네.", "가면 쓴 자들이 탑에서 내려와 씨앗을 배에 실어 보냈지.", "그 배가 닿은 곳마다 몬스터가 들끓었다고 들었네.")

[node name="NpcInspector" type="StaticBody2D" parent="Entities" unique_id=1093993199]
position = Vector2(472, 302)
script = ExtResource("13_woc8j")
display_name = "등대지기"
sheet = ExtResource("15_eqoth")
lines = PackedStringArray("등대 불이 꺼진 뒤로 유령 등불만 길을 떠돈다오.", "절벽 너머 탑에는 아무도 가까이 못 가지.")

[node name="NpcVillager 2" type="StaticBody2D" parent="Entities" unique_id=1373909808]
position = Vector2(136, 318)
script = ExtResource("13_woc8j")
display_name = "어부"
sheet = ExtResource("16_dx644")
lines = PackedStringArray("고기는 안 잡히고 붉은 눈 물고기만 올라와요.", "난파선 무덤엔 해골들이 걸어 다닌대요.")

