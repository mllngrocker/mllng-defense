[node name="NpcOldman 3" type="StaticBody2D" parent="Entities" unique_id=1074049136]
position = Vector2(264, 206)
script = ExtResource("13_lclqy")
display_name = "구름 장로"
sheet = ExtResource("14_jsvjm")
lines = PackedStringArray("땅에서 여기까지 올라온 이는 처음이로구나.", "탑 꼭대기의 큰 나무가 시들고 있다. 그 뿌리에서 검은 열매가 맺혀…", "그 열매가 땅으로 떨어질 때마다 몬스터가 태어나지.")

[node name="NpcPrincess" type="StaticBody2D" parent="Entities" unique_id=862210577]
position = Vector2(472, 318)
script = ExtResource("13_lclqy")
display_name = "바람 소녀"
sheet = ExtResource("15_g1d48")
lines = PackedStringArray("탑을 오르면 큰 나무에 닿을 수 있어요.", "나무가 아파하는 소리, 들리지 않아요?")

