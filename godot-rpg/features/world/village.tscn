[node name="NpcVillagers_v 03 Meadow" type="StaticBody2D" parent="Entities" unique_id=870163282]
position = Vector2(264, 190)
script = ExtResource("13_58mb1")
display_name = "촌장"
sheet = ExtResource("14_82lpy")
lines = PackedStringArray("요즘 밤마다 몬스터 울음소리에 잠을 못 이룬다네…", "어제는 마을 울타리까지 슬라임이 내려왔어.", "이대로 가다간 레몬 마을도 위험하네.")

[node name="NpcVillagers_v 19 Meadow" type="StaticBody2D" parent="Entities" unique_id=582939069]
position = Vector2(536, 190)
script = ExtResource("13_58mb1")
display_name = "경비병"
sheet = ExtResource("15_cra7g")
lines = PackedStringArray("동쪽 초원에서 몬스터가 계속 넘어온다!", "혼자 다 막기엔 역부족이야…", "숲 쪽이 특히 수상해.")

[node name="NpcVillagers_v 26 Meadow" type="StaticBody2D" parent="Entities" unique_id=565275348]
position = Vector2(456, 286)
script = ExtResource("13_58mb1")
display_name = "상인"
sheet = ExtResource("16_6bljs")
lines = PackedStringArray("몬스터 때문에 짐마차가 못 다녀서 큰일이에요.", "좋은 무기는 로비 상점에서 구해 봐요!")

[node name="NpcVillagers_v 01 Meadow" type="StaticBody2D" parent="Entities" unique_id=536217968]
position = Vector2(72, 286)
script = ExtResource("13_58mb1")
display_name = "농부"
sheet = ExtResource("17_rvkna")
lines = PackedStringArray("밭에 갓파 발자국이 찍혀 있었어…", "남쪽 늪에서 올라오는 게 분명해.")

[node name="NpcVillagers_v 22 Meadow" type="StaticBody2D" parent="Entities" unique_id=1360822678]
position = Vector2(552, 318)
script = ExtResource("13_58mb1")
display_name = "아가씨"
sheet = ExtResource("18_ujly2")
lines = PackedStringArray("너희 부모님, 이 근방 최고의 사냥꾼이셨지.", "그 솜씨를 물려받았다면 분명 해낼 거야.")

[node name="NpcVillagers_v 21 Meadow" type="StaticBody2D" parent="Entities" unique_id=855328382]
position = Vector2(232, 382)
script = ExtResource("13_58mb1")
display_name = "소년"
sheet = ExtResource("19_8dy01")
lines = PackedStringArray("형(언니)도 사냥 나가? 나도 데려가!", "폭포 계곡엔 도롱뇽이 산대!")

[node name="NpcVillagers_v 02 Meadow" type="StaticBody2D" parent="Entities" unique_id=272610106]
position = Vector2(408, 78)
script = ExtResource("13_58mb1")
